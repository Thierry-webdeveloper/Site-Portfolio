---
import SocialLinks from "./SocialLinks.astro";

// En-tête commun : identité (retour en haut), bouton de thème, menu.
const liens = [
  { href: "/#accueil", label: "Accueil" },
  { href: "/#a-propos", label: "À propos" },
  { href: "/#competences", label: "Compétences" },
  { href: "/#projets", label: "Projets" },
  { href: "/#parcours", label: "Parcours" },
  { href: "/#contact", label: "Contact" },
];
---

<a class="skip-link" href="#contenu">Aller au contenu</a>

<header class="site-header">
  <a class="brand" href="/#accueil">
    <span class="brand__monogram" aria-hidden="true">TP</span>
    <span class="brand__name">Thierry Pollastri</span>
  </a>

  <div class="header-actions">
    <button class="icon-btn theme-toggle" type="button" aria-pressed="false">
      <span class="visually-hidden">Thème sombre</span>
      <!-- Lune : affichée en thème clair -->
      <svg
        class="icon icon--moon"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <!-- Soleil : affiché en thème sombre -->
      <svg
        class="icon icon--sun"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
    </button>

    <button
      class="icon-btn menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
    >
      <span class="visually-hidden">Menu</span>
      <!-- Trois traits : menu fermé -->
      <svg
        class="icon icon--open"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <!-- Croix : menu ouvert -->
      <svg
        class="icon icon--close"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav class="site-nav" id="menu" aria-label="Navigation principale">
    <ul>
      {
        liens.map((lien) => (
          <li>
            <a href={lien.href}>{lien.label}</a>
          </li>
        ))
      }
    </ul>
    <div class="nav-social">
      <SocialLinks />
    </div>
  </nav>
</header>

<script>
  // --- Bouton de thème ---
  const root = document.documentElement;
  const themeBtn = document.querySelector<HTMLButtonElement>(".theme-toggle");

  if (themeBtn) {
    // Aligne aria-pressed sur le thème réellement affiché
    const syncThemeBtn = () => {
      themeBtn.setAttribute(
        "aria-pressed",
        String(root.classList.contains("dark-theme")),
      );
    };
    syncThemeBtn();

    themeBtn.addEventListener("click", () => {
      const isDark = root.classList.toggle("dark-theme");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch {
        // localStorage indisponible : le thème vaut pour cette visite seulement
      }
      syncThemeBtn();
    });
  }

  // --- Menu mobile ---
  const menuBtn = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.getElementById("menu");

  if (menuBtn && menu) {
    const isMenuOpen = () => menuBtn.getAttribute("aria-expanded") === "true";

    const setMenu = (open: boolean) => {
      menuBtn.setAttribute("aria-expanded", String(open));
    };

    // Ouvre ou ferme au clic sur le bouton
    menuBtn.addEventListener("click", () => setMenu(!isMenuOpen()));

    // Ferme au clic sur un lien (le navigateur suit l'ancre)
    menu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        setMenu(false);
      }
    });

    // Ferme avec Échap et rend le focus au bouton
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isMenuOpen()) {
        setMenu(false);
        menuBtn.focus();
      }
    });

    // Referme le menu quand la fenêtre passe en version desktop
    // (1024 px : même valeur que $bp-desktop, que le script ne peut pas lire)
    const desktop = window.matchMedia("(min-width: 1024px)");
    desktop.addEventListener("change", (event) => {
      if (event.matches) setMenu(false);
    });
  }
</script>

<style lang="scss">
  @use "../styles/variables" as *;

  // Lien d'évitement : hors de l'écran, visible au focus clavier
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background-color: var(--text-color);
    color: var(--bg-color);
    transform: translateY(-200%);

    &:focus {
      transform: none;
    }
  }

  // En-tête fixe en haut de l'écran pendant le défilement
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap; // permet au menu de passer sous la ligne
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 56px;
    padding: var(--space-1) var(--space-3);
    background-color: var(--bg-color);
  }

  // Monogramme + nom : un seul lien vers le haut de page
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }

  .brand__monogram {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--toggle-border);
    border-radius: var(--radius-round);
    font-family: var(--font-serif-condensed);
    font-stretch: var(--serif-width);
    font-style: italic;
    font-weight: 700;
  }

  .brand__name {
    font-family: var(--font-serif-condensed);
    font-stretch: var(--serif-width);
    font-size: 1.25rem;
    font-weight: 700;
  }

  // Boutons de thème et de menu : cibles tactiles de 44 px
  .header-actions {
    display: flex;
    gap: var(--space-2);
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--toggle-border);
    border-radius: var(--radius-round);
    background-color: transparent;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;

    &:hover {
      background-color: var(--btn-hover-bg);
      color: var(--btn-hover-text);
    }
  }

  .menu-toggle {
    border-radius: var(--radius-sm);
  }

  // Une seule icône visible, selon le thème et l'état du menu
  .icon--sun,
  .icon--close {
    display: none;
  }

  :global(:root.dark-theme) .icon--moon {
    display: none;
  }

  :global(:root.dark-theme) .icon--sun {
    display: block;
  }

  .menu-toggle[aria-expanded="true"] {
    .icon--open {
      display: none;
    }

    .icon--close {
      display: block;
    }
  }

  // Menu : replié par défaut, déplié quand le bouton est « développé »
  .site-nav {
    display: none;
    flex-basis: 100%; // occupe toute la largeur, sous la première ligne
    max-height: calc(100dvh - 56px);
    overflow-y: auto;

    ul {
      padding: 0;
      list-style: none;
    }

    a {
      padding-block: var(--space-2);
      border-bottom: none;
      color: var(--text-muted);
      font-size: 0.9rem;
      font-weight: 500;
      // Soulignement présent mais invisible au repos
      text-decoration: underline;
      text-decoration-color: transparent;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.35em;
      transition:
        color var(--duration-fast) ease,
        text-decoration-color var(--duration-fast) ease;

      &:hover {
        color: var(--text-color);
        text-decoration-color: currentColor; // le soulignement apparaît
      }
    }
  }

  .nav-social {
    padding-block: var(--space-4);
  }

  .site-header:has(.menu-toggle[aria-expanded="true"]) .site-nav {
    display: block;
  }

  // --- Desktop : navigation dans l'en-tête ---
  @include from($bp-desktop) {
    .site-header {
      flex-wrap: nowrap;
      gap: var(--space-5);
      padding-inline: var(--space-5);
    }

    // Identité portée par la barre latérale, menu repliable inutile
    .brand,
    .menu-toggle {
      display: none;
    }

    // Le bouton de thème passe après la navigation
    .header-actions {
      order: 1;
    }

    .site-nav {
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: space-between;
      flex-basis: auto;
      max-height: none;
      overflow: visible;

      ul {
        display: flex;
        gap: var(--space-5);
      }

      a {
        padding-block: var(--space-2);
        border-bottom: none;
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 500;
        transition: color var(--duration-fast) ease;

        &:hover {
          color: var(--text-color);
        }
      }
    }

    .nav-social {
      padding-block: 0;
    }
  }
</style>
