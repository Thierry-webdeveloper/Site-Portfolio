---
// En-tête commun : identité (retour en haut), bouton de thème, menu.
const liens = [
  { href: "/#accueil", label: "Accueil" },
  { href: "/#a-propos", label: "À propos" },
  { href: "/#competences", label: "Compétences" },
  { href: "/#projets", label: "Projets" },
  { href: "/#parcours", label: "Parcours" },
  { href: "/#contact", label: "Contact" },
];
---

<a class="skip-link" href="#contenu">Aller au contenu</a>

<header class="site-header">
  <a class="brand" href="/#accueil">
    <span class="brand__monogram" aria-hidden="true">TP</span>
    <span class="brand__name">Thierry Pollastri</span>
  </a>

  <div class="header-actions">
    <button class="icon-btn theme-toggle" type="button" aria-pressed="false">
      <span class="visually-hidden">Thème sombre</span>
      <!-- Lune : affichée en thème clair -->
      <svg
        class="icon icon--moon"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <!-- Soleil : affiché en thème sombre -->
      <svg
        class="icon icon--sun"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
    </button>

    <button
      class="icon-btn menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
    >
      <span class="visually-hidden">Menu</span>
      <!-- Trois traits : menu fermé -->
      <svg
        class="icon icon--open"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <!-- Croix : menu ouvert -->
      <svg
        class="icon icon--close"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav class="site-nav" id="menu" aria-label="Navigation principale">
    <ul>
      {
        liens.map((lien) => (
          <li>
            <a href={lien.href}>{lien.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
