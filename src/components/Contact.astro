---
import { Image } from "astro:assets";
// Section « Contact » : lien direct vers l'adresse e-mail et les profils.
import SocialLinks from "./SocialLinks.astro";
import logo from "../assets/logo.png";

const email = "contact@pollastri.fr";
---

<section id="contact" class="contact" aria-labelledby="contact-titre">
  <h2 id="contact-titre">Contact</h2>

  <p class="contact__intro">
    Un site à créer, une application à développer, une équipe à renforcer&nbsp;?
    Parlons-en.
  </p>

  <a class="contact__email" href={`mailto:${email}`}>
    <svg
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
      ></path>
      <polyline points="22,6 12,13 2,6"></polyline>
    </svg>
    <span><span class="visually-hidden">Écrire à </span>{email}</span>
  </a>

  <SocialLinks />

  <!-- Logo décoratif, affiché seulement sur desktop -->
  <Image
    class="contact__logo"
    src={logo}
    alt=""
    widths={[300, 460, 600, 920]}
    sizes="(min-width: 1840px) 460px, (min-width: 1200px) 25vw, 300px"
  />
</section>

<style lang="scss">
  @use "../styles/variables" as *;

  .contact__intro {
    margin-bottom: var(--space-4);
    font-size: 1.25rem;
  }

  // Bouton principal : pleine largeur sur mobile, ajusté au texte ensuite
  .contact__email {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-bottom: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--text-color);
    border-radius: var(--radius-sm);
    background-color: var(--text-color);
    color: var(--bg-color);
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--duration-base) ease,
      color var(--duration-base) ease;

    &:hover {
      background-color: transparent;
      color: var(--text-color);
    }

    @include from($bp-tablet) {
      display: inline-flex;
    }
  }

  // Logo : masqué sur mobile et tablette (non téléchargé, chargement différé)
  .contact__logo {
    display: none;
  }

  // --- Desktop : texte à gauche, logo centré dans l'espace de droite ---
  @include from($bp-desktop) {
    .contact {
      display: grid;
      grid-template-columns: fit-content(
          32rem
        ) 1fr; // colonne du texte : 32rem au plus
      column-gap: 0; // le logo se centre dans tout l’espace libre
    }

    // Le bouton garde sa taille naturelle dans la grille
    .contact__email {
      justify-self: start;
      align-self: start; // ne s'étire pas en hauteur si le logo est plus haut que le texte
    }

    .contact__logo {
      display: block;
      grid-column: 2; // placé en premier : les autres éléments remplissent la colonne 1
      grid-row: 1 / span 4; // toute la hauteur du contenu (titre, phrase, bouton, logos)
      align-self: center;
      justify-self: center;
      width: min(
        clamp(300px, 25vw, 460px),
        100%
      ); // mini, préférée, maxi ; jamais plus large que la colonne
      height: auto;
    }
  }
</style>
