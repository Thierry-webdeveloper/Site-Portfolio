---
// Section « Projets » : lit la collection et passe des données simples à la galerie React.
import { getCollection } from "astro:content";
import ProjectGallery from "./ProjectGallery.jsx";

const projets = (await getCollection("projets"))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .map((projet) => ({ id: projet.id, ...projet.data }));
---

<section id="projets" aria-labelledby="projets-titre">
  <h2 id="projets-titre">Projets</h2>
  <ProjectGallery projets={projets} />
</section>
