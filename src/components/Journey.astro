---
// Section « Parcours » : frise verticale sur mobile et tablette, horizontale sur desktop, du plus ancien au projet à venir.
const etapes = [
  {
    periode: "1985 – 1989",
    texte:
      "Programmation et électronique en autodidacte (BASIC, assembleur, Pascal, automatismes)",
  },
  {
    periode: "1988 – 2024",
    texte: "Négoce de matériaux, au contact des artisans du bâtiment (37 ans)",
  },
  {
    periode: "2014 – aujourd’hui",
    texte: "Domotique avec Home Assistant (YAML)",
  },
  {
    periode: "2026",
    texte: "Formation Intégrateur Web, OpenClassrooms",
  },
  {
    periode: "Ensuite",
    texte:
      "Consultant indépendant : sites vitrines pour les artisans et TPE du Var",
  },
];
---

<section id="parcours" class="journey" aria-labelledby="parcours-titre">
  <h2 id="parcours-titre">Parcours</h2>

  <ol class="timeline" role="list">
    {
      etapes.map((etape) => (
        <li class="timeline__item">
          <p class="timeline__period">{etape.periode}</p>
          <p class="timeline__text">{etape.texte}</p>
        </li>
      ))
    }
  </ol>
</section>

<style lang="scss">
  @use "../styles/variables" as *;

  .timeline {
    max-width: var(--measure);
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    position: relative;
    padding-left: var(--space-5);
    padding-bottom: var(--space-5);

    // Point de l'étape
    &::before {
      content: "";
      position: absolute;
      top: 0.3em;
      left: 0;
      width: 12px;
      height: 12px;
      border-radius: var(--radius-round);
      background-color: var(--accent);
    }

    // Trait vertical vers l'étape suivante (sauf après la dernière)
    &:not(:last-child)::after {
      content: "";
      position: absolute;
      top: calc(0.3em + 16px);
      bottom: 4px;
      left: 5px;
      width: 2px;
      background-color: var(--toggle-border);
    }

    // Dernière étape, à venir : point creux
    &:last-child {
      padding-bottom: 0;

      &::before {
        border: 2px solid var(--accent);
        background-color: transparent;
      }
    }
  }

  .timeline__period {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 700;
  }

  // --- Desktop et écran large : frise horizontale ---
  @include from($bp-desktop) {
    .timeline {
      --timeline-gap: var(--space-4);

      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr)); // une colonne par étape
      gap: var(--timeline-gap);
      max-width: none;
    }

    .timeline__item {
      padding: var(--space-5) 0 0; // le point passe au-dessus du texte

      &::before {
        top: 0;
      }

      // Trait horizontal jusqu'au point de l'étape suivante
      &:not(:last-child)::after {
        top: 5px;
        right: calc(-1 * var(--timeline-gap) + 4px);
        bottom: auto;
        left: 16px;
        width: auto;
        height: 2px;
      }
    }
  }
</style>
