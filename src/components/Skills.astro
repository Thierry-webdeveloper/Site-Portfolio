---
// Section « Compétences » : 4 groupes de badges, décrits comme des données.
import {
  siHtml5,
  siCss,
  siSass,
  siJavascript,
  siReact,
  siAstro,
  siGit,
  siNotion,
  siFigma,
  siHomeassistant,
} from "simple-icons";

// Icônes au trait (modèle Feather Icons) pour les compétences sans logo de marque
const traits = {
  accessibilite:
    '<circle cx="12" cy="5" r="1"/><path d="m9 20 3-6 3 6"/><path d="m6 8 6 2 6-2"/><path d="M12 10v4"/>',
  seo: '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
  performance: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
  tests:
    '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>',
  kanban:
    '<rect x="3" y="3" width="18" height="18" rx="2"/><rect x="7" y="7" width="3" height="9"/><rect x="14" y="7" width="3" height="5"/>',
};

// marque : logo plein (Simple Icons) ; trait : icône au trait ; aucun des deux : pas d'icône
type Badge = { nom: string; marque?: { path: string }; trait?: string };

const groupes: { titre: string; badges: Badge[] }[] = [
  {
    titre: "Technique",
    badges: [
      { nom: "HTML", marque: siHtml5 },
      { nom: "CSS", marque: siCss },
      { nom: "Sass", marque: siSass },
      { nom: "JavaScript", marque: siJavascript },
      { nom: "React", marque: siReact },
      { nom: "Astro", marque: siAstro },
      { nom: "Git", marque: siGit },
    ],
  },
  {
    titre: "Qualité",
    badges: [
      { nom: "Accessibilité", trait: traits.accessibilite },
      { nom: "SEO", trait: traits.seo },
      { nom: "Performance", trait: traits.performance },
      { nom: "Tests", trait: traits.tests },
    ],
  },
  {
    titre: "Méthode",
    badges: [
      { nom: "Agile / Kanban", trait: traits.kanban },
      { nom: "Rigueur" },
      { nom: "Pédagogie" },
    ],
  },
  {
    titre: "Outils",
    badges: [
      { nom: "Notion", marque: siNotion },
      { nom: "Figma", marque: siFigma },
      { nom: "Home Assistant (YAML)", marque: siHomeassistant },
    ],
  },
];
---

<section id="competences" class="skills" aria-labelledby="competences-titre">
  <h2 id="competences-titre">Compétences</h2>

  <div class="skills__grid">
    {
      groupes.map((groupe) => (
        <div class="skills__group">
          <h3>{groupe.titre}</h3>
          <ul class="skills__list">
            {groupe.badges.map((badge) => (
              <li class="badge">
                {badge.marque && (
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    fill="currentColor"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d={badge.marque.path} />
                  </svg>
                )}
                {badge.trait && (
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                    set:html={badge.trait}
                  />
                )}
                {badge.nom}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
