---
// Section « Compétences » : 4 groupes de badges, décrits comme des données.
import {
  siHtml5,
  siCss,
  siSass,
  siJavascript,
  siReact,
  siRedux,
  siAstro,
  siGit,
  siNotion,
  siFigma,
  siHomeassistant,
} from "simple-icons";

import { traits } from "../data/themes";

// marque : logo plein (Simple Icons) ; trait : icône au trait ; aucun des deux : pas d'icône
type Badge = { nom: string; marque?: { path: string }; trait?: string };

const groupes: { titre: string; badges: Badge[] }[] = [
  {
    titre: "Technique",
    badges: [
      { nom: "HTML", marque: siHtml5 },
      { nom: "CSS", marque: siCss },
      { nom: "Sass", marque: siSass },
      { nom: "JavaScript", marque: siJavascript },
      { nom: "React", marque: siReact },
      { nom: "Redux", marque: siRedux },
      { nom: "Astro", marque: siAstro },
      { nom: "Git", marque: siGit },
    ],
  },
  {
    titre: "Qualité",
    badges: [
      { nom: "Responsive design", trait: traits.responsive },
      { nom: "Accessibilité", trait: traits.accessibilite },
      { nom: "SEO", trait: traits.seo },
      { nom: "Performance", trait: traits.performance },
      { nom: "Tests", trait: traits.tests },
    ],
  },
  {
    titre: "Méthode",
    badges: [
      { nom: "Agile / Kanban", trait: traits.kanban },
      { nom: "Rigueur" },
      { nom: "Pédagogie" },
    ],
  },
  {
    titre: "Outils",
    badges: [
      { nom: "Notion", marque: siNotion },
      { nom: "Figma", marque: siFigma },
      { nom: "Home Assistant (YAML)", marque: siHomeassistant },
    ],
  },
];
---

<section id="competences" class="skills" aria-labelledby="competences-titre">
  <h2 id="competences-titre">Compétences</h2>

  <div class="skills__grid">
    {
      groupes.map((groupe) => (
        <div class="skills__group">
          <h3>{groupe.titre}</h3>
          <ul class="skills__list" role="list">
            {groupe.badges.map((badge) => (
              <li class="badge">
                {badge.marque && (
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    fill="currentColor"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d={badge.marque.path} />
                  </svg>
                )}
                {badge.trait && (
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                    set:html={badge.trait}
                  />
                )}
                {badge.nom}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use "../styles/variables" as *;

  // Groupes : 1 colonne sur mobile, 2 sur tablette, 4 sur desktop
  .skills__grid {
    display: grid;
    gap: var(--space-5);

    @include from($bp-tablet) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @include from($bp-desktop) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .skills__group h3 {
    margin-bottom: var(--space-3);
  }

  // Badges qui passent à la ligne quand la place manque
  .skills__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  // Pilule : icône en couleur d'accent, texte en police système
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.4;

    svg {
      flex-shrink: 0;
      color: var(--accent);
    }
  }
</style>
