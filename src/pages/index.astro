---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Skills from "../components/Skills.astro";
import Journey from "../components/Journey.astro";
import Contact from "../components/Contact.astro";
---

<BaseLayout
  title="Thierry Pollastri — Portfolio"
  description="Portfolio de Thierry Pollastri : compétences, projets et parcours."
>
  <Hero />
  <About />
  <Skills />

  <section id="projets" aria-labelledby="projets-titre">
    <h2 id="projets-titre">Projets</h2>
  </section>

  <section id="temoignages" aria-labelledby="temoignages-titre">
    <h2 id="temoignages-titre">Retours des évaluateurs</h2>
  </section>

  <Journey />
  <Contact />
</BaseLayout>
