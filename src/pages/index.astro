---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thierry Pollastri — Portfolio"
  description="Portfolio de Thierry Pollastri : compétences, projets et parcours."
>
  <section id="accueil" aria-labelledby="accueil-titre">
    <h1 id="accueil-titre">Thierry Pollastri</h1>
  </section>

  <section id="a-propos" aria-labelledby="a-propos-titre">
    <h2 id="a-propos-titre">À propos</h2>
  </section>

  <section id="competences" aria-labelledby="competences-titre">
    <h2 id="competences-titre">Compétences</h2>
  </section>

  <section id="projets" aria-labelledby="projets-titre">
    <h2 id="projets-titre">Projets</h2>
  </section>

  <section id="temoignages" aria-labelledby="temoignages-titre">
    <h2 id="temoignages-titre">Retours des évaluateurs</h2>
  </section>

  <section id="parcours" aria-labelledby="parcours-titre">
    <h2 id="parcours-titre">Parcours</h2>
  </section>

  <section id="contact" aria-labelledby="contact-titre">
    <h2 id="contact-titre">Contact</h2>
  </section>
</BaseLayout>
